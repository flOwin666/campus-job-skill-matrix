# LLM_API 选择并填入你的 Key 即可
# 目前支持的 API（OpenAI 兼容格式）：
# DeepSeek:     LLM_ENDPOINT=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
# 通义千问:      LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# Kimi (Moonshot): LLM_ENDPOINT=https://api.moonshot.cn/v1  LLM_MODEL=moonshot-v1-8k
# 自己部署:      LLM_ENDPOINT=http://你的IP:端口/v1  LLM_MODEL=你的模型名

LLM_ENDPOINT=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_KEY=sk-your-key-here

# 管理员密码（管理技能新增/删除、数据刷新）
ADMIN_PASSWORD=200633

# GitHub PAT（仅需 repo:contents + repo:actions 权限）
GITHUB_PAT=ghp_your_pat_here
